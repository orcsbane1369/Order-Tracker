# Copy this file to `.env` (a hidden file) next to docker-compose.yml and edit the copy. It is never committed.
# One KEY=value per line, comments only on their own lines, avoid the dollar sign in values.

# Port on the Unraid server the app answers on (Work Hours uses 5005, Bills Tracker 5006).
OT_PORT=5007

# Where the database lives on the server.
OT_DATA_DIR=/mnt/user/appdata/ordertracker

# Shown at the top of the app and on quotes.
OT_BUSINESS_NAME=Our Creations
# Optional line on quotes, such as a phone number or email.
OT_BUSINESS_CONTACT=
# Optional footer on quotes, such as "Quote valid for 30 days."
OT_QUOTE_NOTE=

# Email (needed for the Email Quote button). Leave OT_SMTP_HOST empty to turn email off.
# Gmail: host smtp.gmail.com, port 587, security starttls, user = your Gmail address,
# password = a Google "App password" (Google Account > Security > 2-Step Verification > App passwords).
OT_SMTP_HOST=
OT_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
OT_SMTP_SECURITY=starttls
OT_SMTP_USER=
OT_SMTP_PASSWORD=
# The From address on quotes. Empty = the SMTP user.
OT_SMTP_FROM=
# Low-stock alert emails are sent to OT_SMTP_USER (or OT_SMTP_FROM if the user is empty).
# Optional: where customer replies go.
OT_SMTP_REPLY_TO=
